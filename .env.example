# HeyTools Environment

# Required in production — absolute site origin (no trailing slash).
# Used for canonical URLs, Open Graph, sitemap, and robots.txt.
PUBLIC_SITE_URL=https://heytools.app

# Supabase (optional for local tool-only browsing; required for auth/favorites/history)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Never expose the service role key to the browser.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Feature flags
PUBLIC_FF_AUTH=true

# Analytics (pick one; leave both unset locally)
# PUBLIC_PLAUSIBLE_DOMAIN=heytools.app
# PUBLIC_SA_DOMAIN=heytools.app

# Ads placeholders (true | false)
# PUBLIC_ADS_ENABLED=false
